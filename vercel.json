{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/process-cases",
      "schedule": "0 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "stats.ma-system.co.jp" }],
      "destination": "/stats/",
      "permanent": false
    }
  ]
}
